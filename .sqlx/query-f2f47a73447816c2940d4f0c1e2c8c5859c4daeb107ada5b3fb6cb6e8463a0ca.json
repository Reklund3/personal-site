  "query": "\n        SELECT\n            newsletter_issue_id,\n            title,\n            status as \"status: NewsletterIssueStatus\",\n            published_at\n        FROM newsletter.newsletter_issues\n        WHERE status <> 'draft'\n        ORDER BY published_at DESC\n        LIMIT 20\n        ",
